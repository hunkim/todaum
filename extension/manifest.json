{
  "manifest_version": 3,
  "name": "ToDaum",
  "version": "1.0.3",
  "description": "뉴스 기사를 같은 다음 뉴스로 엽니다. 홈·목록은 그대로 둡니다. Daum·카카오와 무관한 개인 프로젝트입니다.",
  "permissions": [
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "https://n.news.naver.com/*",
    "https://news.naver.com/*",
    "https://m.news.naver.com/*",
    "https://*.chosun.com/*",
    "https://*.joins.com/*",
    "https://*.joongang.co.kr/*",
    "https://*.donga.com/*",
    "https://*.hani.co.kr/*",
    "https://*.khan.co.kr/*",
    "https://*.mk.co.kr/*",
    "https://*.mt.co.kr/*",
    "https://*.hankyung.com/*",
    "https://*.sedaily.com/*",
    "https://*.yna.co.kr/*",
    "https://*.yonhapnews.co.kr/*",
    "https://*.newsis.com/*",
    "https://*.news1.kr/*",
    "https://*.jtbc.co.kr/*",
    "https://*.sbs.co.kr/*",
    "https://*.kbs.co.kr/*",
    "https://*.imbc.com/*",
    "https://*.ytn.co.kr/*",
    "https://*.fnnews.com/*",
    "https://*.edaily.co.kr/*",
    "https://*.asiae.co.kr/*",
    "https://*.nocutnews.co.kr/*",
    "https://*.ohmynews.com/*",
    "https://*.segye.com/*",
    "https://*.kmib.co.kr/*",
    "https://*.munhwa.com/*",
    "https://*.seoul.co.kr/*",
    "https://*.busan.com/*",
    "https://*.koreaherald.com/*",
    "https://*.koreatimes.co.kr/*",
    "https://*.etnews.com/*",
    "https://*.zdnet.co.kr/*",
    "https://*.bloter.net/*",
    "https://news.nate.com/*",
    "https://n.news.nate.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ToDaum",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "homepage_url": "https://todaum.vercel.app"
}
